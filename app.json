{
  "expo": {
    "name": "BrainGuin",
    "slug": "brainguin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "brainguin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "appleTeamId": "86BLA5VR2L",
      "bundleIdentifier": "com.brainguin.app",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.brainguin.app"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow access to photo library to upload images.",
        "NSCameraUsageDescription": "This app needs access to your camera to upload images.",
        "NSCalendarsUsageDescription": "The app needs to access your calendar to save appointments.",
        "CFBundleDisplayName": "BrainGuin"
      },
      "icon": {
        "dark": "./assets/images/main.png",
        "light": "./assets/images/main.png"
      }
    },
    "android": {
      "package": "com.brainguin.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/images/main.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "backgroundColor": "#1E293B"
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-apple-authentication",
      "@bacons/apple-targets",
      "react-native-android-widget"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d8e047ea-0955-44df-bd82-7e1375baf699"
      }
    },
    "owner": "franciccio"
  }
}
