{
  "expo": {
    "name": "BrainGuin",
    "slug": "brainguin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "brainguin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "appleTeamId": "86BLA5VR2L",
      "bundleIdentifier": "com.brainguin.app",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.brainguin.app"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow access to photo library to upload images.",
        "NSCameraUsageDescription": "This app needs access to your camera to upload images.",
        "NSCalendarsUsageDescription": "The app needs to access your calendar to save appointments.",
        "CFBundleDisplayName": "BrainGuin"
      },
      "icon": {
        "dark": "./assets/images/main.png",
        "light": "./assets/images/main.png"
      }
    },
    "android": {
      "package": "com.brainguin.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/images/main.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "backgroundColor": "#1E293B"
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-apple-authentication",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgetTaskHandlerName": "widgetTaskHandler",
          "widgets": [
            {
              "name": "Android", // This name will be the **name** with which we will reference our widget.
              "label": "BrainGuin", // Label shown in the widget picker
              "minWidth": "320dp",
              "minHeight": "120dp",
              // This means the widget's default size is 5x2 cells, as specified by the targetCellWidth and targetCellHeight attributes.
              // Or 320×120dp, as specified by minWidth and minHeight for devices running Android 11 or lower.
              // If defined, targetCellWidth,targetCellHeight attributes are used instead of minWidth or minHeight.
              "targetCellWidth": 5,
              "targetCellHeight": 2,
              "description": "Keep track of your studies", // Description shown in the widget picker
              "previewImage": "./assets/images/main.png", // Path to widget preview image
              "widgetFeatues": "reconfigurable",
              "resizeMode": "horizontal|vertical|none"

              // How often, in milliseconds, that this AppWidget wants to be updated.
              // The task handler will be called with widgetAction = 'UPDATE_WIDGET'.
              // Default is 0 (no automatic updates)
              // Minimum is 1800000 (30 minutes == 30 * 60 * 1000).
              // "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d8e047ea-0955-44df-bd82-7e1375baf699"
      }
    },
    "owner": "franciccio"
  }
}
